{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node", "jest"],

    "paths": {
      "src/*": ["./src/*.ts"],
      "utils/*": ["./src/utils/*.ts"],
      "solution/*": ["./*.ts"],
      "constants/*": ["./src/constants/*.ts"],
      "pageObjects/*": ["./src/pageObjects/*.ts"],
      "types": ["./src/types/*.ts"]
    },

    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    "noEmit": true,
    "sourceMap": true
  },
  "include": ["src/**/*", "jest.config.ts", "tests/**/*.test.ts"],
  "exclude": ["node_modules", "2026"]
}
