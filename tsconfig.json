{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node", "jest"],

    "paths": {
      "src/*": ["./src/*.ts"],
      "solution/*": ["./*.ts"]
    },

    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    "noEmit": true,
    "sourceMap": true
  },
  "include": ["src/**/*", "jest.config.ts", "tests/**/*.test.ts"],
  "exclude": ["node_modules", "2026"]
}
